rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper function: Hanya iskakfatoni@gmail.com yang terverifikasi di Firebase Auth yang boleh write
    function isAuthorizedAdmin() {
      return request.auth != null && request.auth.token.email.lower() == 'iskakfatoni@gmail.com';
    }

    // Koleksi Guru (teachers)
    match /teachers/{document=**} {
      allow read: if true;
      allow write: if isAuthorizedAdmin();
    }

    // Koleksi Formulir (forms)
    match /forms/{document=**} {
      allow read: if true;
      allow write: if isAuthorizedAdmin();
    }

    // Koleksi Jadwal Mengajar (schedules)
    match /schedules/{document=**} {
      allow read: if true;
      allow write: if isAuthorizedAdmin();
    }

    // Koleksi Pengaturan (settings)
    match /settings/{document=**} {
      allow read: if true;
      allow write: if isAuthorizedAdmin();
    }

    // Koleksi Riwayat Pengisian (submissions)
    // Diperlukan agar App/Web bisa mencatat riwayat pengisian tanpa login Firebase Auth
    match /submissions/{document=**} {
      allow read: if true;
      allow write: if true;
    }

    // Koleksi Konfigurasi App (config) - Digunakan untuk Sistem Update APK
    match /config/{document=**} {
      allow read: if true;
      allow write: if true; // SEMENTARA: Agar AI bisa membuat koleksi ini. Ubah kembali ke isAuthorizedAdmin() setelah selesai.
    }
  }
}