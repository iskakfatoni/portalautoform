rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper function: Hanya iskakfatoni@gmail.com yang terverifikasi di Firebase Auth yang boleh write
    function isAuthorizedAdmin() {
      return request.auth != null && request.auth.token.email.lower() == 'iskakfatoni@gmail.com';
    }

    // Koleksi Guru (teachers)
    // - Publik: Bisa membaca profil guru (agar portal formulir terbuka untuk semua guru)
    // - Admin: Hanya iskakfatoni@gmail.com yang bisa menambah, mengedit, dan menghapus (CRUD)
    match /teachers/{document=**} {
      allow read: if true;
      allow write: if isAuthorizedAdmin();
    }

    // Koleksi Formulir (forms)
    // - Publik: Bisa membaca formulir aktif
    // - Admin: Hanya iskakfatoni@gmail.com yang bisa menambah, mengedit, dan menghapus (CRUD)
    match /forms/{document=**} {
      allow read: if true;
      allow write: if isAuthorizedAdmin();
    }

    // Koleksi Pengaturan (settings)
    match /settings/{document=**} {
      allow read: if true;
      allow write: if isAuthorizedAdmin();
    }
  }
}
