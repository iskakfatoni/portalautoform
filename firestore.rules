rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper function: cek apakah user adalah admin
    function isAdmin() {
      return request.auth != null && (
        request.auth.token.email == 'iskakfatoni@gmail.com' ||
        request.auth.token.admin == true
      );
    }

    // Koleksi Guru (teachers)
    // - Publik/Guru: Bisa membaca data profil guru
    // - Admin: Bisa membaca dan mengubah (CRUD)
    match /teachers/{nip} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Koleksi Formulir (forms)
    // - Publik/Guru: Bisa membaca formulir yang aktif
    // - Admin: Bisa membaca dan mengubah (CRUD)
    match /forms/{formId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Koleksi Konfigurasi / Pengaturan
    match /settings/{document=**} {
      allow read: if true;
      allow write: if isAdmin();
    }
  }
}
