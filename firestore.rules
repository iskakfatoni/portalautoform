rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper function: Admin Auth Check
    function isAuthorizedAdmin() {
      return request.auth != null && request.auth.token.email.lower() == 'iskakfatoni@gmail.com';
    }

    // ==========================================
    // PORTAL:AutoForm Collections
    // ==========================================

    // 1. Koleksi Guru (teachers)
    match /teachers/{teacherId} {
      allow read: if true;
      allow create, delete: if isAuthorizedAdmin();
      // Admin berhak mengubah seluruh data guru; Guru mandiri hanya dapat mengubah PIN & pinUpdatedAt
      allow update: if isAuthorizedAdmin() || 
                    (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['pin', 'pinUpdatedAt']));
    }

    // 2. Koleksi Formulir (forms)
    match /forms/{document=**} {
      allow read: if true;
      allow write: if isAuthorizedAdmin();
    }

    // 3. Koleksi Jadwal Mengajar (schedules)
    match /schedules/{document=**} {
      allow read: if true;
      allow write: if isAuthorizedAdmin();
    }

    // 4. Koleksi Riwayat Pengisian (submissions)
    match /submissions/{document=**} {
      allow read, create, update: if true;
      allow delete: if isAuthorizedAdmin();
    }

    // 5. Koleksi Konfigurasi App (config)
    match /config/{document=**} {
      allow read: if true;
      allow write: if isAuthorizedAdmin();
    }

    // 6. Koleksi Capaian / Tujuan Pembelajaran (learning_objectives)
    match /learning_objectives/{document=**} {
      allow read: if true;
      allow write: if isAuthorizedAdmin();
    }

    // ==========================================
    // System Absensi & Master Collections
    // ==========================================

    // Log & Sesi Absensi
    match /log_absensi/{docId} {
      allow read, create, update: if true;
      allow delete: if isAuthorizedAdmin();
    }
    match /sesi_absensi/{docId} {
      allow read, create, update: if true;
      allow delete: if isAuthorizedAdmin();
    }

    // Siswa, Kelas, Mapel & Links
    match /siswa/{docId} {
      allow read: if true;
      allow write: if isAuthorizedAdmin();
    }
    match /kelas/{docId} {
      allow read: if true;
      allow write: if isAuthorizedAdmin();
    }
    match /mapel/{docId} {
      allow read: if true;
      allow write: if isAuthorizedAdmin();
    }
    match /links/{docId} {
      allow read: if true;
      allow write: if isAuthorizedAdmin();
    }

    // Admin Devices & Settings
    match /admin_devices/{docId} {
      allow read, write: if isAuthorizedAdmin();
    }
    match /settings/{docId} {
      allow read: if true;
      allow write: if isAuthorizedAdmin();
    }
    
    // System Logs & Trash Bin
    match /system_logs/{docId} {
      allow read, create: if true;
      allow update, delete: if isAuthorizedAdmin();
    }
    match /trash_bin/{docId} {
      allow read, write: if isAuthorizedAdmin();
    }
  }
}