rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper function: Setiap user yang berhasil login via Google Auth di project ini adalah Admin
    function isAdmin() {
      return request.auth != null;
    }

    // Koleksi Guru (teachers)
    // - Publik / Guru: Bisa membaca profil guru
    // - Admin terautentikasi: Bisa menambah, mengedit, dan menghapus (CRUD)
    match /teachers/{nip} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Koleksi Formulir (forms)
    // - Publik / Guru: Bisa membaca formulir aktif
    // - Admin terautentikasi: Bisa menambah, mengedit, dan menghapus (CRUD)
    match /forms/{formId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Koleksi Pengaturan (settings)
    match /settings/{document=**} {
      allow read: if true;
      allow write: if isAdmin();
    }
  }
}
