rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper function: Hanya iskakfatoni@gmail.com yang terverifikasi di Firebase Auth yang boleh write
    function isAuthorizedAdmin() {
      return request.auth != null && request.auth.token.email.lower() == 'iskakfatoni@gmail.com';
    }

    // Koleksi Guru (teachers)
    match /teachers/{teacherId} {
      allow read: if true;
      // Admin punya akses penuh
      allow write: if isAuthorizedAdmin();
      // Guru diizinkan UPDATE hanya untuk field pin dan pinUpdatedAt
      allow update: if request.resource.data.diff(resource.data).affectedKeys().hasOnly(['pin', 'pinUpdatedAt']);
    }

    // Koleksi Formulir (forms)
    match /forms/{document=**} {
      allow read: if true;
      allow write: if isAuthorizedAdmin();
    }

    // Koleksi Jadwal Mengajar (schedules)
    match /schedules/{document=**} {
      allow read: if true;
      allow write: if isAuthorizedAdmin();
    }

    // Koleksi Pengaturan (settings)
    match /settings/{document=**} {
      allow read: if true;
      allow write: if isAuthorizedAdmin();
    }

    // Koleksi Riwayat Pengisian (submissions)
    match /submissions/{document=**} {
      allow read: if true;
      allow write: if true;
    }

    // Koleksi Konfigurasi App (config)
    match /config/{document=**} {
      allow read: if true;
      allow write: if isAuthorizedAdmin() || true; // Tetap allow true sementara jika masih dalam pengembangan
    }
  }
}